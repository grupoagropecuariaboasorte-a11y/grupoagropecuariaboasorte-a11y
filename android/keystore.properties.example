# Modelo de configuracao para assinatura do APK de release
# Copie este arquivo para 'keystore.properties' (que esta ignorado no .gitignore)
# e coloque o arquivo 'BOASORTE-debug.keystore' na pasta android/app/
storeFile=BOASORTE-debug.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
